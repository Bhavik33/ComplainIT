# ==========================================
# ResolveIT Environment Variables Example
# ==========================================

# System Environment
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/resolveit
MONGODB_DOCKER_URI=mongodb://mongodb:27017/resolveit

# Authentication Secrets
JWT_SECRET=resolveit_super_secret_jwt_key_2026_change_in_production
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=resolveit_super_secret_refresh_key_2026
JWT_REFRESH_EXPIRES_IN=7d

# Email Notification Service (Nodemailer / SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=notifications@resolveit.com
EMAIL_PASSWORD=your_app_password_here
EMAIL_FROM=ResolveIT Portal <notifications@resolveit.com>

# SonarQube & DevOps Integration
SONAR_HOST_URL=http://localhost:9000
SONAR_TOKEN=your_sonarqube_token_here

# Docker Registry
DOCKER_USERNAME=resolveituser
DOCKER_PASSWORD=your_dockerhub_password
DOCKER_IMAGE_BACKEND=resolveituser/resolveit-backend:latest
DOCKER_IMAGE_FRONTEND=resolveituser/resolveit-frontend:latest
